{
  "manifest_version": 3,
  "name": "本地屏幕内容与观点采集助手",
  "version": "0.2.1",
  "description": "仅在本机采集时向桌面端提供当前页面的结构化上下文。",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "连接本地采集助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8765"
  }
}
